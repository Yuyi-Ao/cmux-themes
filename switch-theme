#!/usr/bin/env python3
"""Choose a cmux theme; preserve running sessions."""
import os, subprocess, sys, json
from pathlib import Path
ROOT = Path(__file__).resolve().parent
THEMES = ['slate', 'cool-light', 'plum', 'dark', 'forest', 'graphite', 'light', 'parchment', 'mist', 'white']
THEMES += sorted(p.name for p in (ROOT/'themes').iterdir() if p.is_dir() and (p/'terminal.conf').is_file() and p.name not in THEMES)
def main():
    args = sys.argv[1:]
    if args and args[0] == 'cmux':
        args = args[1:]
        if args and args[0] in ('--help', '-h'):
            print('./cmux-theme [theme | restore]'); return
        if not args:
            for i, name in enumerate(THEMES, 1): print(f'{i:2}. {name}')
            choice = input('cmux theme (q to cancel)> ').strip()
            if choice == 'q': return
            if not choice.isdigit() or not 1 <= int(choice) <= len(THEMES): raise SystemExit('Invalid choice.')
            args = [THEMES[int(choice)-1]]
        if args[0] not in THEMES and args[0] != 'restore': raise SystemExit('Unknown cmux theme.')
    if not args:
        print('Choose a theme:')
        for i, name in enumerate(THEMES, 1): print(f'{i:2}. {name}')
        print(' s. Choose Starship style\n r. Restore previous settings\n q. Quit')
        choice = input('> ').strip()
        if choice == 'q': return
        args = ['starship' if choice == 's' else 'restore' if choice == 'r' else THEMES[int(choice)-1] if choice.isdigit() and 1 <= int(choice) <= len(THEMES) else choice]
    action = args[0]
    if action in ('codex', 'claude'):
        os.execv(sys.executable, [sys.executable, str(ROOT/'tools/launch.py'), *args])
    if action in ('--help', '-h'):
        print('./switch-theme [theme | starship [style] | restore | codex | claude]'); return
    cmd = [sys.executable, str(ROOT/'tools/install.py')]
    if action == 'starship':
        if len(args) > 1 and args[1] in ('--help', '-h'):
            print('./starship-theme [style | theme]'); return
        styles = sorted(str(p.relative_to(ROOT/'starship').with_suffix('')) for p in (ROOT/'starship').rglob('*.toml')) + ['theme']
        preferred = json.loads((ROOT/'starship/order.json').read_text())
        styles = [name for name in preferred if name in styles] + [name for name in styles if name not in preferred]
        if len(args) > 1: style = args[1]
        else:
            for i, name in enumerate(styles, 1): print(f'{i:2}. {name}')
            choice = input('Starship style (q to cancel)> ').strip()
            if choice == 'q': return
            if not choice.isdigit() or not 1 <= int(choice) <= len(styles): raise SystemExit('Invalid choice.')
            style = styles[int(choice)-1]
        style = 'tokyo-night' if style == 'tokyo-night/terminal' else style.removeprefix('community/')
        if style not in styles: raise SystemExit('Unknown Starship style.')
        selection = Path.home()/'.config/cmux/reading-selection.json'
        preset = json.loads(selection.read_text())['preset'] if selection.exists() else 'slate'
        cmd += [preset, '--starship', style, '--apply']
    elif action == 'restore':
        backups = sorted(p for p in (Path.home()/'.config/cmux/reading-backups').glob('*') if (p/'manifest.json').is_file() and not (p/'.restored').exists())
        if not backups: raise SystemExit('No previous settings to restore.')
        cmd += ['--rollback', str(backups[-1]), '--apply']
    elif action in THEMES: cmd += [action, '--apply']
    else: raise SystemExit('Unknown choice. Run ./switch-theme for the menu.')
    subprocess.run(cmd, check=True)
    cmux = Path('/Applications/cmux.app/Contents/Resources/bin/cmux')
    if cmux.exists():
        result = subprocess.run([str(cmux), 'reload-config'], timeout=15)
        if result.returncode: print('Settings saved. Reload cmux configuration when the app is running.')
    print('Open a new shell for the prompt. Existing jobs are unchanged.')
if __name__ == '__main__':
    try: main()
    except (KeyboardInterrupt, EOFError): print('\nCancelled.')
    except (ValueError, subprocess.SubprocessError) as exc: raise SystemExit(str(exc))
